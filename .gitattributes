# Check out every text file with LF on all platforms. Windows runners default to
# core.autocrlf=true, which would hand Prettier CRLF files and fail format:check.
* text=auto eol=lf

# Binary assets: never touch line endings or diff as text.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.onnx binary
